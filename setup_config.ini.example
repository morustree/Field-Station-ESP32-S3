# ESP32-S3 Field Station Configuration
# Fill in the values below between quotes (DO NOT remove the quotes "").
# Preencha os valores abaixo entre aspas (NÃO remova as aspas "").

[wifi]
ssid = "YOUR_WIFI_NAME"
password = "YOUR_WIFI_PASSWORD"

[mqtt]
# Your computer's local IP address (run 'ipconfig' in terminal)
broker_ip = "XXX.XXX.X.XXX"
device_id = "esp32s3_01"

[station]
# Interval between measurements in minutes.
# Recommended minimum: 10 seconds (~0.16 min).
deep_sleep_minutes = 5
